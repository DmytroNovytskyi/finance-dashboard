# Copy to .env on the deploy host and fill in real values.
# .env lives OUTSIDE the repository and is never committed.
# Every variable below is read by the deployment Compose file.

# Postgres credentials (required)
DB_USER=finance
DB_PASSWORD=change-me

# Currency (ISO 4217) in which stored amounts are expressed. Default: PLN.
FINANCE_BASE_CURRENCY=PLN

# Container timezone (IANA name).
TZ=Europe/Warsaw

# Host port published for the frontend.
FRONTEND_PORT=8100
